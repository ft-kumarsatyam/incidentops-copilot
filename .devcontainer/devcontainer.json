{
  "name": "IncidentOps Copilot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install uv && make setup && make web-build",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "IncidentOps (API + UI)", "onAutoForward": "openBrowser" },
    "5173": { "label": "UI hot reload (make web-dev)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"],
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
    }
  }
}
