# Incident evidence (read-only)
GITHUB_TOKEN=

# n8n owns Slack/Jira credentials and write actions
ACTION_PROVIDER=n8n
N8N_ACTION_WEBHOOK_URL=
INCIDENTOPS_API_KEY=replace-with-a-long-random-value
INCIDENTOPS_URL=http://localhost:8000
# Where people open the web UI from Slack (the link in the approval message)
INCIDENTOPS_PUBLIC_URL=http://localhost:8000
# Shared secret: the API sends it, n8n checks it on the actions webhook
N8N_ACTION_TOKEN=replace-with-a-long-random-value
# Storage. Empty = SQLite at DATABASE_PATH. A postgresql:// URL switches the read-model, audit log
# and workflow checkpoints to Postgres (schema migrations run on startup). For the bundled db:
#   DATABASE_URL=postgresql://incidentops:local-db-password@db:5432/incidentops
#   docker compose --profile postgres up
DATABASE_URL=
DATABASE_POOL_SIZE=10
# Redis shares the live event stream (SSE) and rate limits across API replicas. Empty = in-process.
# If Redis is unreachable the API keeps serving: events and limits fall back to per-replica.
# For the bundled redis: REDIS_URL=redis://redis:6379/0 and docker compose --profile redis up
REDIS_URL=
REDIS_PREFIX=incidentops
# Optional HMAC signing. Outbound: signs dispatches to n8n/Zapier (headers X-IncidentOps-Timestamp
# and X-IncidentOps-Signature, message "{timestamp}.{body}", SHA-256, 5 min window).
WEBHOOK_SIGNING_SECRET=
# Inbound: when set, POST /incidents must carry a valid signature as well as the API key.
INBOUND_SIGNING_SECRET=
# Comma-free JSON list of hosts the dispatcher may call, e.g. ["n8n.internal"]. Empty = any.
OUTBOUND_ALLOWED_HOSTS=[]
# Alternative: Webhooks by Zapier Catch Hook. Set ACTION_PROVIDER=zapier.
ZAPIER_ACTION_WEBHOOK_URL=
ZAPIER_ACTION_TOKEN=
ZAPIER_DISPATCH_ATTEMPTS=3
ZAPIER_DISPATCH_BACKOFF=0.5
N8N_PUBLIC_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=replace-before-sharing
SLACK_BOT_TOKEN=
GITHUB_REPO=owner/repository

# Deployment. "dev" allows running without an API key; anything else requires one.
INCIDENTOPS_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=256000

# AI. "auto" uses Claude when ANTHROPIC_API_KEY is set; otherwise deterministic rules.
# "rules" never calls a model. "claude" requires the key and fails fast without it.
AI_PROVIDER=auto
# monolithic (default) or specialists (parallel RoleGraph roles inside assess)
AI_TOPOLOGY=monolithic
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-haiku-5-5
SPECIALIST_MODEL=
# Optional MCP read bridge during research (JSON list in MCP_SERVERS)
MCP_ENABLED=false
MCP_SERVERS=[]
ROLEGRAPH_MAX_PARALLEL=4
TRIAGE_EFFORT=medium
CRITIC_EFFORT=low
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000

# Storage and workflow
DATABASE_PATH=.data/incidentops.db
RUNBOOK_DIR=runbooks
RUNBOOK_DB=.data/runbooks.db
# fts (default) or hybrid (requires pip install '.[rag]' and runbooks index)
RUNBOOK_RETRIEVAL=fts
MAX_RUNBOOK_RESULTS=3
AUTO_INDEX_RUNBOOKS=false
MAX_RESEARCH_ATTEMPTS=2
CONFIDENCE_THRESHOLD=0.8

# Optional OpenTelemetry export (install the [otel] extra)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318