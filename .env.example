# Incident evidence (read-only)
GITHUB_TOKEN=

# n8n owns Slack/Jira credentials and write actions
ACTION_PROVIDER=n8n
N8N_ACTION_WEBHOOK_URL=
INCIDENTOPS_API_KEY=replace-with-a-long-random-value
INCIDENTOPS_URL=http://localhost:8000
# Where people open the web UI from Slack (the link in the approval message)
INCIDENTOPS_PUBLIC_URL=http://localhost:8000
# Shared secret: the API sends it, n8n checks it on the actions webhook
N8N_ACTION_TOKEN=replace-with-a-long-random-value
# Storage. Empty = SQLite at DATABASE_PATH. A postgresql:// URL switches the read-model, audit log
# and workflow checkpoints to Postgres (schema migrations run on startup). For the bundled db:
#   DATABASE_URL=postgresql://incidentops:local-db-password@db:5432/incidentops
#   docker compose --profile postgres up
DATABASE_URL=
DATABASE_POOL_SIZE=10
# Redis shares the live event stream (SSE) and rate limits across API replicas. Empty = in-process.
# If Redis is unreachable the API keeps serving: events and limits fall back to per-replica.
# For the bundled redis: REDIS_URL=redis://redis:6379/0 and docker compose --profile redis up
REDIS_URL=
REDIS_PREFIX=incidentops
# Execution. sync (default) runs the analysis inside POST /incidents. async answers 202 at once and
# a worker runs it: durable queue in the same database, leases, retries with backoff, and a dead
# state you can retry from the UI. Needs one database all processes share (Postgres for several).
EXECUTION_MODE=sync
# In-process workers on the API. 0 = none; run `incidentops worker` (or the compose `workers`
# profile) as separate processes instead. Add REDIS_URL so their updates reach the API's live stream.
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=2.0
# A single analysis is abandoned (and retried) after this long.
RUN_TIMEOUT_SECONDS=300
# Ceiling for `Prefer: wait=N` on POST /incidents.
MAX_WAIT_SECONDS=30
# Optional HMAC signing. Outbound: signs dispatches to n8n/Zapier (headers X-IncidentOps-Timestamp
# and X-IncidentOps-Signature, message "{timestamp}.{body}", SHA-256, 5 min window).
WEBHOOK_SIGNING_SECRET=
# Inbound: when set, POST /incidents must carry a valid signature as well as the API key.
INBOUND_SIGNING_SECRET=
# Comma-free JSON list of hosts the dispatcher may call, e.g. ["n8n.internal"]. Empty = any.
OUTBOUND_ALLOWED_HOSTS=[]
# Alternative: Webhooks by Zapier Catch Hook. Set ACTION_PROVIDER=zapier.
ZAPIER_ACTION_WEBHOOK_URL=
ZAPIER_ACTION_TOKEN=
ZAPIER_DISPATCH_ATTEMPTS=3
ZAPIER_DISPATCH_BACKOFF=0.5
N8N_PUBLIC_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=replace-before-sharing
SLACK_BOT_TOKEN=
# Slack app > Basic Information > Signing Secret. When set, n8n rejects intake requests whose
# signature is missing, stale or wrong. Leave empty to skip the check (demo only).
SLACK_SIGNING_SECRET=
# Shared idempotency store for several n8n instances, e.g. redis://redis:6379/1. Empty = per-instance.
N8N_REDIS_URL=
GITHUB_REPO=owner/repository

# Deployment. "dev" allows running without an API key; anything else requires one.
INCIDENTOPS_ENV=dev
# Secrets can also come from files (Docker/Kubernetes secrets, Vault agent): set NAME_FILE=/path
# instead of NAME, e.g. INCIDENTOPS_API_KEY_FILE=/run/secrets/api_key. Outside dev the API and the
# worker refuse to start while a secret still holds a placeholder (local-*, change-me).

# --- Identity and access ----------------------------------------------------------------------
# Callers authenticate with one of: a scoped key (`incidentops keys create`, sent as
# `Authorization: Bearer iops_...`), an SSO access token (set OIDC_* below), or the legacy shared
# INCIDENTOPS_API_KEY (admin in the default tenant; X-Actor names the caller, unverified).
# Roles: viewer < responder < approver < admin. Everything below is optional.
DEFAULT_TENANT=default
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=incidentops            # required with OIDC_ISSUER
# OIDC_JWKS_URL=                       # default: discovered from the issuer
# OIDC_ROLES_CLAIM=roles               # dotted path ok, e.g. realm_access.roles
# OIDC_TENANT_CLAIM=tenant_id          # missing claim = DEFAULT_TENANT
# OIDC_ACTOR_CLAIM=sub                 # what the audit log records: sub, email, preferred_username
# Governance
# FOUR_EYES_APPROVALS=2                # distinct approvers for the severities below
# FOUR_EYES_SEVERITIES=["SEV-1"]
# FORBID_SELF_APPROVAL=true            # whoever opened an incident cannot approve it
# AUDIT_RETENTION_DAYS=365             # used by `incidentops audit prune`; 0 keeps everything
# AUDIT_READS=true                     # also log every incident someone opens
LOG_LEVEL=INFO
LOG_JSON=false
# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=256000

# AI. "auto" uses Claude when ANTHROPIC_API_KEY is set; otherwise deterministic rules.
# "rules" never calls a model. "claude" requires the key and fails fast without it.
AI_PROVIDER=auto
# monolithic (default) or specialists (parallel RoleGraph roles inside assess)
AI_TOPOLOGY=monolithic
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-haiku-5-5
SPECIALIST_MODEL=
# Optional MCP read bridge during research (JSON list in MCP_SERVERS)
MCP_ENABLED=false
MCP_SERVERS=[]
ROLEGRAPH_MAX_PARALLEL=4
TRIAGE_EFFORT=medium
CRITIC_EFFORT=low
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000

# Storage and workflow
DATABASE_PATH=.data/incidentops.db
RUNBOOK_DIR=runbooks
RUNBOOK_DB=.data/runbooks.db
# fts (default) or hybrid (requires pip install '.[rag]' and runbooks index)
RUNBOOK_RETRIEVAL=fts
# sqlite (default, one file per instance) or postgres (one shared index in DATABASE_URL; hybrid then
# uses pgvector, so run the pgvector/pgvector:pg17 image)
RUNBOOK_STORE=sqlite
MAX_RUNBOOK_RESULTS=3
AUTO_INDEX_RUNBOOKS=false
MAX_RESEARCH_ATTEMPTS=2
CONFIDENCE_THRESHOLD=0.8

# Seconds a stopping server waits for open connections (live-event streams) before closing them
SHUTDOWN_TIMEOUT_SECONDS=5

# Prometheus metrics at /metrics (install the [metrics] extra). Outside dev a token is required.
METRICS_ENABLED=false
# METRICS_TOKEN=change-me

# Optional OpenTelemetry export (install the [otel] extra)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318