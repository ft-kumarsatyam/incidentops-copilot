{
  "name": "IncidentOps Copilot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incidentops/intake",
        "responseMode": "responseNode"
      },
      "id": "incident-ingress",
      "name": "Slack Incident Ingress",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json; const e = b.event ?? b; return [{json:{run_id:b.run_id,channel_id:e.channel ?? b.channel_id,thread_ts:e.thread_ts ?? e.ts ?? b.thread_ts,reporter:e.user ?? b.reporter,summary:e.text ?? b.summary,service:b.service ?? '',owner:b.owner ?? '',symptoms:b.symptoms ?? [e.text ?? b.summary],monitoring:b.monitoring ?? {},github:b.github ?? {}}}];"
      },
      "id": "normalize",
      "name": "Normalize Incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INCIDENTOPS_URL + '/incidents'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.INCIDENTOPS_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {}
      },
      "id": "call-graph",
      "name": "Run LangGraph",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SLACK_BOT_TOKEN}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {channel:$json.channel_id,thread_ts:$json.thread_ts,text:'IncidentOps: ' + ($json.severity || 'unrated') + ' - ' + $json.summary + '\\n' + ($json.status === 'needs_human' ? 'The agents could not reach a safe conclusion. A person needs to take over.' : 'Proposed actions: ' + ($json.proposed_actions || []).join('; ')) + '\\nReview and decide: ' + ($env.INCIDENTOPS_PUBLIC_URL || $env.INCIDENTOPS_URL) + '/#/incidents/' + $json.run_id} }}",
        "options": {}
      },
      "id": "post-approval",
      "name": "Post Approval to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true, message:'approval posted'} }}"
      },
      "id": "respond-ingress",
      "name": "Acknowledge Incident",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.github.com/repos/' + $env.GITHUB_REPO + '/issues'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$json.idempotency_key}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {title:'Incident ' + $json.run_id + ': ' + $json.summary,body:'Approved by a person in IncidentOps.\\n\\nApproved actions:\\n- ' + ($json.approved_actions || []).join('\\n- ') + '\\n\\nIdempotency key: ' + $json.idempotency_key,labels:['incident']} }}",
        "options": {}
      },
      "id": "create-issue",
      "name": "Create GitHub Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1210,
        460
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true, executed:$json.execute ?? true, duplicate:$json.duplicate ?? false} }}"
      },
      "id": "respond-decision",
      "name": "Return Decision",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1760,
        520
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incidentops/actions",
        "responseMode": "responseNode"
      },
      "id": "action-dispatch",
      "name": "Approved Action Dispatch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        330,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json; const key = 'action:' + String(b.idempotency_key ?? ''); if (key === 'action:') throw new Error('idempotency_key required'); const seen = $getWorkflowStaticData('global'); const duplicate = Boolean(seen[key] && seen[key].done); if (!duplicate) seen[key] = {run_id:b.run_id, at:new Date().toISOString(), done:false}; return [{json:{...b,duplicate,execute:!duplicate}}];"
      },
      "id": "action-idempotency",
      "name": "Action Idempotency Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.execute}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "action-new",
      "name": "New Approved Action?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        990,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const header = String(($json.headers ?? {}).authorization ?? '');\nconst secret = String($env.N8N_ACTION_TOKEN ?? '');\nif (!secret) throw new Error('N8N_ACTION_TOKEN is not configured');\nconst expected = 'Bearer ' + secret;\nlet diff = header.length ^ expected.length;\nfor (let i = 0; i < expected.length; i++) diff |= (header.charCodeAt(i) || 0) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('unauthorized');\nreturn [$input.first()];"
      },
      "id": "verify-action-token",
      "name": "Verify Action Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const gate = $('Action Idempotency Gate').first().json; const key = 'action:' + String(gate.idempotency_key); const seen = $getWorkflowStaticData('global'); seen[key] = {...(seen[key] || {}), done:true, completed_at:new Date().toISOString()}; return [{json:{...gate,duplicate:false,execute:true}}];"
      },
      "id": "mark-action-done",
      "name": "Mark Action Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        460
      ]
    }
  ],
  "connections": {
    "Slack Incident Ingress": {
      "main": [
        [
          {
            "node": "Normalize Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Incident": {
      "main": [
        [
          {
            "node": "Run LangGraph",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run LangGraph": {
      "main": [
        [
          {
            "node": "Post Approval to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Approval to Slack": {
      "main": [
        [
          {
            "node": "Acknowledge Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved Action Dispatch": {
      "main": [
        [
          {
            "node": "Verify Action Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Action Idempotency Gate": {
      "main": [
        [
          {
            "node": "New Approved Action?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New Approved Action?": {
      "main": [
        [
          {
            "node": "Create GitHub Incident",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create GitHub Incident": {
      "main": [
        [
          {
            "node": "Mark Action Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Action Token": {
      "main": [
        [
          {
            "node": "Action Idempotency Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Action Done": {
      "main": [
        [
          {
            "node": "Return Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "incidentops-copilot-v2"
}
